# Copy to .env.local for local dev, or set as real env vars at build/deploy
# time (Vite inlines these at BUILD time, not runtime — a rebuild is needed
# after changing either).

# The backend's real origin. That origin's CORS_ORIGIN must list this site's
# own deployed origin, or the signup form's POST /auth/tenants call will be
# blocked by the browser.
VITE_API_BASE_URL=http://localhost:3000

# Where "Sign in" and the post-signup "verify your email, then sign in"
# message link to — the frontend/ SPA's own deployed origin.
VITE_APP_URL=http://localhost:5173
